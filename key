-- 显示状态消息
function KeySystem:ShowStatus(ui, message, isSuccess)
    ui.StatusLabel.Text = message
    ui.StatusLabel.TextColor3 = isSuccess and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100)
    
    -- 抖动效果（如果失败）
    if not isSuccess then
        local shake = TweenService:Create(
            ui.MainFrame,
            TweenInfo.new(0.05, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, 0, true),
            {Position = UDim2.new(0.5, -190, 0.5, -125)}
        )
        shake:Play()
        shake.Completed:Wait()
        ui.MainFrame.Position = UDim2.new(0.5, -200, 0.5, -125)
    end
end

-- 验证密钥
function KeySystem:VerifyKey(key)
    -- 这里可以添加更复杂的验证逻辑
    if key == CONFIG.CorrectKey then
        return true
    end
    return false
end

-- 保存密钥
function KeySystem:SaveKey(key)
    if CONFIG.SaveKey then
        writefile("key.txt", key) -- 需要 exploit 支持
    end
end

-- 加载保存的密钥
function KeySystem:LoadKey()
    if CONFIG.SaveKey and isfile and isfile("key.txt") then
        return readfile("key.txt")
    end
    return nil
end

-- 初始化
function KeySystem:Init(onSuccess)
    -- 检查保存的密钥
    local savedKey = self:LoadKey()
    if savedKey and self:VerifyKey(savedKey) then
        onSuccess()
        return
    end
    
    -- 创建 UI
    local ui = self:CreateUI()
    
    -- 获取密钥按钮
    ui.GetKeyButton.MouseButton1Click:Connect(function()
        setclipboard(CONFIG.KeyLink) -- 复制链接到剪贴板
        self:ShowStatus(ui, "✓ 链接已复制到剪贴板", true)
    end)
    
    -- 验证按钮
    ui.VerifyButton.MouseButton1Click:Connect(function()
        local inputKey = ui.KeyInput.Text
        
        if inputKey == "" then
            self:ShowStatus(ui, "✗ 请输入密钥", false)
            return
        end
        
        ui.VerifyButton.Text = "验证中..."
        ui.VerifyButton.BackgroundColor3 = Color3.fromRGB(128, 128, 128)
        wait(0.5)
        
        if self:VerifyKey(inputKey) then
            self:ShowStatus(ui, "✓ 验证成功！", true)
            self:SaveKey(inputKey)
            wait(1)
            
            -- 关闭动画
            TweenService:Create(
                ui.MainFrame,
                TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In),
                {Size = UDim2.new(0, 0, 0, 0)}
            ):Play()
            
            wait(0.3)
            ui.ScreenGui:Destroy()
            onSuccess()
        else
            self:ShowStatus(ui, "✗ 密钥错误，请重试", false)
            ui.VerifyButton.Text = "✓ 验证密钥"
            ui.VerifyButton.BackgroundColor3 = Color3.fromRGB(88, 101, 242)
        end
    end)
end

return KeySystem