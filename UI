		local TrackCorner = New("UICorner")
		TrackCorner.CornerRadius = dm(0, 12)
		TrackCorner.Parent = Track

		local TrackStroke = New("UIStroke")
		TrackStroke.Color = THEME.BORDERS.MEDIUM
		TrackStroke.Transparency = 0.2
		TrackStroke.Thickness = 1
		TrackStroke.Parent = Track

		local Knob = New("Frame")
		Knob.Parent = Track
		Knob.AnchorPoint = Vector2.new(0, 0)
		Knob.Position = UDim2.new(0, 2, 0, 2)
		Knob.Size = UDim2.new(0, 20, 0, 20)
		Knob.BackgroundColor3 = THEME.WHITE
		Knob.BorderSizePixel = 0

		local KnobCorner = New("UICorner")
		KnobCorner.CornerRadius = dm(1, 0)
		KnobCorner.Parent = Knob

		local KnobStroke = New("UIStroke")
		KnobStroke.Color = THEME.BORDER
		KnobStroke.Transparency = 0.2
		KnobStroke.Thickness = 1
		KnobStroke.Parent = Knob

		local function render(state)
			if state then
				tween(Track, { BackgroundColor3 = THEME.GOOD }, 0.18):Play()
				tween(TrackStroke, { Color = THEME.GOOD, Transparency = 0.1 }, 0.18):Play()
				tween(Knob, { Position = UDim2.new(0, 44 - 2 - 20, 0, 2) }, 0.18):Play()
			else
				tween(Track, { BackgroundColor3 = THEME.CONTROL.TOGGLE_OFF_START }, 0.18):Play()
				tween(TrackStroke, { Color = THEME.BORDERS.MEDIUM, Transparency = 0.2 }, 0.18):Play()
				tween(Knob, { Position = UDim2.new(0, 2, 0, 2) }, 0.18):Play()
			end
		end

		library.flags[key] = {
			State = false,
			Callback = callback,
			SetState = function(self, state)
				local v = (state ~= nil) and state or (not library.flags:GetState(key))
				library.flags[key].State = v
				task.spawn(function() pcall(library.flags[key].Callback, v) end)
				render(v)
			end
		}

		Row.MouseButton1Click:Connect(function()
			library.flags[key]:SetState()
		end)

		if default then
			library.flags[key]:SetState(default)
		else
			render(false)
		end
	end

	function API:NewBind(label, defaultKeyName, callback)
		callback = callback or noop
		local invalidKey = { Return=true, Space=true, Tab=true, Backquote=true, CapsLock=true, Escape=true, Unknown=true }
		local alias = {
			RightControl="Right Ctrl", LeftControl="Left Ctrl", LeftShift="Left Shift", RightShift="Right Shift",
			Semicolon=";", Quote='"', LeftBracket="[", RightBracket="]", Equals="=", Minus="-",
			RightAlt="Right Alt", LeftAlt="Left Alt"
		}

		local currentKey = Enum.KeyCode[(defaultKeyName or "None")] or nil
		local display = currentKey and (alias[currentKey.Name] or currentKey.Name) or "None"

		local Row = makeCell(32)
		Row.Name = "KeybindModule"
		Row.Text = "  " .. tostring(label)

		local Value = New("TextButton")
		Value.Name = "KeybindValue"
		Value.Parent = Row
		Value.BackgroundColor3 = THEME.CONTROL.INPUT_BG
		Value.BorderSizePixel = 0
		Value.Position = dn(0.75, 0, 0.5, -9)
		Value.Size = dn(0, 76, 0, 18)
		Value.AutoButtonColor = false
		Value.Font = Enum.Font.Gotham
		Value.Text = display
		Value.TextColor3 = THEME.TEXT
		Value.TextSize = 12

		local ValueCorner = New("UICorner")
		ValueCorner.CornerRadius = R.small
		ValueCorner.Parent = Value

		local ValueStroke = New("UIStroke")
		ValueStroke.Color = THEME.BORDER
		ValueStroke.Transparency = 0.3
		ValueStroke.Thickness = 1
		ValueStroke.Parent = Value

		UserInputService.InputBegan:Connect(function(input, gpe)
			if gpe then return end
			if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
			if currentKey and input.KeyCode == currentKey then
				pcall(callback, currentKey.Name)
			end
		end)

		Value.MouseButton1Click:Connect(function()
			Value.Text = "..."
			local input = UserInputService.InputEnded:Wait()
			if input.UserInputType ~= Enum.UserInputType.Keyboard then
				Value.Text = display
				return
			end
			local keyName = input.KeyCode.Name
			if invalidKey[keyName] then
				Value.Text = display
				return
			end
			currentKey = Enum.KeyCode[keyName]
			display = alias[keyName] or keyName
			Value.Text = display
		end)
	end

	-- iOS Slider：细轨 + 蓝色填充 + 圆把手
	function API:NewSlider(label, key, defaultValue, minValue, maxValue, allowFloat, callback)
		callback = callback or noop
		defaultValue = (defaultValue ~= nil) and defaultValue or minValue

		local Row = makeCell(40)
		Row.Name = "SliderModule"
		Row.Text = "  " .. tostring(label)

		local Bar = New("Frame")
		Bar.Parent = Row
		Bar.BackgroundColor3 = THEME.BAR
		Bar.BorderSizePixel = 0
		Bar.Position = dn(0, 110, 0.5, -2)
		Bar.Size = dn(0, 120, 0, 4)

		local BarCorner = New("UICorner")
		BarCorner.CornerRadius = R.small
		BarCorner.Parent = Bar

		local Fill = New("Frame")
		Fill.Parent = Bar
		Fill.BackgroundColor3 = THEME.ACCENT
		Fill.BorderSizePixel = 0
		Fill.Size = dn(0, 0, 1, 0)

		local FillCorner = New("UICorner")
		FillCorner.CornerRadius = R.small
		FillCorner.Parent = Fill

		local Handle = New("Frame")
		Handle.Parent = Fill
		Handle.AnchorPoint = Vector2.new(1, 0.5)
		Handle.Position = UDim2.new(1, -1, 0.5, 0)
		Handle.Size = UDim2.new(0, 10, 0, 10)
		Handle.BackgroundColor3 = THEME.WHITE
		Handle.BorderSizePixel = 0
		local HandleCorner = New("UICorner"); HandleCorner.CornerRadius = dm(1,0); HandleCorner.Parent = Handle
		local HandleStroke = New("UIStroke"); HandleStroke.Color = THEME.BORDER; HandleStroke.Transparency = 0.2; HandleStroke.Thickness = 1; HandleStroke.Parent = Handle

		local ValueBox = New("TextBox")
		ValueBox.Name = "SliderValue"
		ValueBox.Parent = Row
		ValueBox.BackgroundColor3 = THEME.CONTROL.INPUT_BG
		ValueBox.BorderSizePixel = 0
		ValueBox.Position = dn(1, -44, 0.5, -9)
		ValueBox.Size = dn(0, 40, 0, 18)
		ValueBox.Font = Enum.Font.Gotham
		ValueBox.Text = tostring(defaultValue)
		ValueBox.TextColor3 = THEME.TEXT
		ValueBox.TextSize = 12
		local VCorner = New("UICorner"); VCorner.CornerRadius = R.small; VCorner.Parent = ValueBox
		local VStroke = New("UIStroke"); VStroke.Color = THEME.BORDER; VStroke.Transparency = 0.3; VStroke.Thickness = 1; VStroke.Parent = ValueBox

		library.flags[key] = {
			State = defaultValue,
			SetValue = function(self, newVal)
				local mouseX = UserInputService:GetMouseLocation().X
				local ratio
				if typeof(newVal) == "number" then
					ratio = (newVal - minValue) / (maxValue - minValue)
				else
					ratio = (mouseX - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X
				end
				ratio = math.clamp(ratio, 0, 1)
				local val = minValue + (maxValue - minValue) * ratio
				if not allowFloat then
					val = math.floor(val + 0.5)
				else
					val = tonumber(string.format("%.1f", val))
				end
				library.flags[key].State = val
				ValueBox.Text = tostring(val)
				Fill.Size = dn(ratio, 0, 1, 0)
				pcall(callback, val)
			end
		}

		-- 拖动
		local dragging = false
		Bar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				library.flags[key]:SetValue()
				dragging = true
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then dragging = false end
				end)
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				library.flags[key]:SetValue()
			end
		end)

		-- 文本输入
		local editing = false
		ValueBox.Focused:Connect(function() editing = true end)
		ValueBox.FocusLost:Connect(function(enter)
			editing = false
			if not enter then return end
			local n = tonumber(ValueBox.Text)
			if not n then
				ValueBox.Text = tostring(library.flags:GetState(key))
				return
			end
			n = math.clamp(n, minValue, maxValue)
			library.flags[key]:SetValue(n)
		end)
		ValueBox:GetPropertyChangedSignal("Text"):Connect(function()
			if not editing then return end
			if allowFloat then
				local cleaned = ValueBox.Text:gsub("[^%d%.%-]", "")
				local firstMinus = cleaned:find("%-")
				if firstMinus and firstMinus > 1 then cleaned = cleaned:gsub("%-", "") end
				local firstDot = cleaned:find("%.")
				if firstDot then
					local before = cleaned:sub(1, firstDot)
					local after = cleaned:sub(firstDot + 1):gsub("%.", "")
					ValueBox.Text = before .. after
				else
					ValueBox.Text = cleaned
				end
			else
				ValueBox.Text = ValueBox.Text:gsub("%D+", "")
			end
		end)

		-- 初始化
		library.flags[key]:SetValue(defaultValue)
	end

	function API:NewDropdown(label, key, options, callback)
		callback = callback or noop
		options = options or {}
		key = key or label

		library.flags[key] = { State = options[1] }

		local Row = makeCell(32)
		Row.Name = "DropdownModule"
		Row.Text = ""

		local Input = New("TextBox")
		Input.Parent = Row
		Input.BackgroundTransparency = 1
		Input.Position = dn(0, 8, 0, 0)
		Input.Size = dn(0, 200, 1, 0)
