        KeybindValue.TextColor3 = THEME.TEXT
        KeybindValue.TextSize = 12
        
        ValueCorner.CornerRadius = CornerRadius.small
        ValueCorner.Name = "KeybindValueCorner"
        ValueCorner.Parent = KeybindValue
        
        -- 监听按键
        Services.UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            if input.KeyCode ~= currentKey then return end
            callback(currentKey.Name)
        end)
        
        -- 更改按键
        KeybindValue.MouseButton1Click:Connect(function()
            KeybindValue.Text = "..."
            wait()
            local inputEnded = Services.UserInputService.InputEnded:Wait()
            local keyName = tostring(inputEnded.KeyCode.Name)
            
            if inputEnded.UserInputType ~= Enum.UserInputType.Keyboard then
                KeybindValue.Text = displayText
                return
            end
            
            if blacklistedKeys[keyName] then
                KeybindValue.Text = displayText
                return
            end
            
            wait()
            currentKey = Enum.KeyCode[keyName]
            KeybindValue.Text = keyNames[keyName] or keyName
        end)
    end
    
