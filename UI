        local OptionsPadding = Instance.new("UIPadding")
        OptionsPadding.PaddingTop = UDim.new(0, 6)
        OptionsPadding.Parent = OptionsContainer
        
        local isOpen = false
        
        -- 按搜索文本过滤选项
        local function filterOptions()
            local searchText = SearchBox.Text:lower()
            for _, element in pairs(OptionsContainer:GetChildren()) do
                if element:IsA("TextButton") then
                    element.Visible = element.Name:lower():find(searchText) ~= nil
                end
            end
        end
        
        -- 切换下拉
        local function toggleDropdown()
            isOpen = not isOpen
            
            if isOpen then
                OptionsContainer.Visible = true
                filterOptions()
            else
                task.spawn(function()
                    task.wait(0.35)
                    if not isOpen then
                        OptionsContainer.Visible = false
                    end
                end)
            end
            
            ToggleButton.Text = isOpen and "-" or "+"
            
            local targetSize = isOpen and OptionsLayout.AbsoluteContentSize.Y + 12 or 0
            Utils:CreateTween(OptionsContainer, {Size = UDim2.new(0, 312, 0, targetSize)}, 0.35):Play()
        end
        
        ToggleButton.MouseButton1Click:Connect(toggleDropdown)
        
        SearchBox.Focused:Connect(function()
            if not isOpen then
                toggleDropdown()
            end
        end)
        
        SearchBox:GetPropertyChangedSignal("Text"):Connect(filterOptions)
        
        -- 当选项改变时更新容器大小
        OptionsLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            if not isOpen then return end
            Utils:CreateTween(OptionsContainer, {Size = UDim2.new(0, 312, 0, OptionsLayout.AbsoluteContentSize.Y + 12)}, 0.1):Play()
        end)
        
        -- 方法
        Library.flags[flagName].SetOptions = function(self, newOptions)
            self:ClearOptions()
            for _, option in ipairs(newOptions) do
                self:AddOption(option)
            end
        end
        
        Library.flags[flagName].ClearOptions = function(self)
            for _, element in pairs(OptionsContainer:GetChildren()) do
                if element:IsA("TextButton") then
                    element:Destroy()
                end
            end
        end
        
        Library.flags[flagName].AddOption = function(self, optionText)
            local Option = Instance.new("TextButton")
            Option.Name = optionText
            Option.Parent = OptionsContainer
            Option.BackgroundColor3 = THEME.CONTROL.DROPDOWN_ITEM_BG
            Option.BorderSizePixel = 0
            Option.Size = UDim2.new(0, 300, 0, 28)
            Option.AutoButtonColor = false
            Option.Font = Enum.Font.GothamSemibold
            Option.Text = optionText
            Option.TextColor3 = THEME.TEXT.PRIMARY
            Option.TextSize = 14
            
            local OptionCorner = Instance.new("UICorner")
            OptionCorner.CornerRadius = RADIUS.LARGE
            OptionCorner.Parent = Option
            
            Option.MouseButton1Click:Connect(function()
                SearchBox.PlaceholderText = optionText
                SearchBox.Text = ""
                Library.flags[flagName].State = optionText
                task.spawn(toggleDropdown)
                pcall(callback, optionText)
            end)
        end
        
        Library.flags[flagName].RemoveOption = function(self, optionText)
            local option = OptionsContainer:FindFirstChild(optionText)
            if option then
                option:Destroy()
            end
        end
        
        -- 初始化选项
        Library.flags[flagName]:SetOptions(options)
        
        return Library.flags[flagName]
    end
    
