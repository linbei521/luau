-- 初始化通知系统
local notificationHolder = createNotificationSystem()
local notificationCount = 0
local lastRemovedPosition = nil

-- 选择通知函数
function library:SelectNotify(args)
    args = args or {}
    args.TweenSpeed = args.TweenSpeed or 1
    args.TweenInSpeed = args.TweenInSpeed or args.TweenSpeed
    args.TweenOutSpeed = args.TweenOutSpeed or args.TweenSpeed
    args.TweenVerticalSpeed = args.TweenVerticalSpeed or args.TweenSpeed
    args.Title = args.Title or "Title"
    args.Text = args.Text or "Text"
    args.TrueText = args.TrueText or "Yes"
    args.FalseText = args.FalseText or "No"
    args.Duration = args.Duration or 5
    args.Callback = args.Callback or function() warn("No callback for notification") end
    
    notificationCount = notificationCount + 1
    local trackCount = notificationCount
    local notifNumber = notificationCount
    local exists = true
    local notification = notificationHolder.ToggleNotif:Clone()
    local wasRemoved = false
    
    notification.Parent = notificationHolder
    notification.Visible = true
    notification.Position = UDim2.new(1, 300, 1, -5)
    notification.Transparency = 0.05
    notification.True.Text = args.TrueText
    notification.False.Text = args.FalseText
    
    task.spawn(function()
        task.wait(args.Duration + args.TweenInSpeed)
        exists = false
    end)
    
    notification.True.MouseButton1Click:Connect(function()
        exists = false
        wasRemoved = true
        notificationCount = notificationCount - 1
        lastRemovedPosition = notification.Position.Y.Offset
        pcall(args.Callback, true)
    end)
    
    notification.False.MouseButton1Click:Connect(function()
        exists = false
        wasRemoved = true
        notificationCount = notificationCount - 1
        lastRemovedPosition = notification.Position.Y.Offset
        pcall(args.Callback, false)
    end)
    
    notification.Paragraph.Text = args.Text
    notification.Title.Text = args.Title
    notification:TweenPosition(UDim2.new(1, -5, 1, -5), Enum.EasingDirection.Out, Enum.EasingStyle.Quint, args.TweenInSpeed)
    
    task.spawn(function()
        local originalPosition = notification.Position
        while exists and task.wait() do
            local currentPosition = notification.Position
            if notificationCount > trackCount then
                notification:TweenPosition(
                    UDim2.new(1, -5, 1, originalPosition.Y.Offset - (65 * (notificationCount - notifNumber))),
                    Enum.EasingDirection.Out,
                    Enum.EasingStyle.Quint,
                    args.TweenVerticalSpeed,
                    true
                )
                trackCount = trackCount + 1
            end
            if notificationCount < trackCount then
                if lastRemovedPosition > currentPosition.Y.Offset then
                    notification:TweenPosition(
                        UDim2.new(1, -5, 1, originalPosition.Y.Offset - (65 * (notificationCount - notifNumber))),
                        Enum.EasingDirection.Out,
                        Enum.EasingStyle.Quint,
                        args.TweenVerticalSpeed,
                        true
                    )
                else
                    notifNumber = notifNumber - 1
                end
                trackCount = trackCount - 1
            end
        end
        
        local finalPosition = notification.Position
        if not wasRemoved then
            notificationCount = notificationCount - 1
            lastRemovedPosition = notification.Position.Y.Offset
        end
        
        notification:TweenPosition(
            UDim2.new(1, 300, 1, finalPosition.Y.Offset),
            Enum.EasingDirection.Out,
            Enum.EasingStyle.Quint,
            args.TweenOutSpeed,
            true
        )
        task.wait(args.TweenOutSpeed)
        notification:Destroy()
    end)
end

