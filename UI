-- 更新开关状态
function library:UpdateToggle(flagName, newState)
    local currentState = library.flags:GetState(flagName)
    if newState == currentState then
        return
    end
    library.flags[flagName]:SetState(newState)
end

-- ========== 动画工具 ==========
local AnimationUtils = {}

function AnimationUtils:Tween(properties, instance, duration, easingStyle, easingDirection)
    local tweenInfo = TweenInfo.new(
        duration or 0.25,
        Enum.EasingStyle[easingStyle or "Linear"],
        Enum.EasingDirection[easingDirection or "InOut"]
    )
    return Services.TweenService:Create(instance, tweenInfo, properties)
end

function AnimationUtils:SwitchTab(newTab)
    local currentTab = library.currentTab
    if currentTab == newTab then return end
    
    library.currentTab = newTab
    
    -- 动画切换
    AnimationUtils:Tween({ Transparency = 1 }, currentTab[2].Glow):Play()
    AnimationUtils:Tween({ Transparency = 0 }, newTab[2].Glow):Play()
    
    -- 切换可见性
    currentTab[1].Visible = false
    newTab[1].Visible = true
end

