library.flags = library.flags or {
	GetState = function(self, key)
		local f = rawget(library.flags, key)
		return f and f.State or nil
	end
}
library.modules = library.modules or {}
library.currentTab = library.currentTab or nil

function library:UpdateToggle(key, state)
	local flag = library.flags[key]
	if not flag then return end
	local desired = (state ~= nil) and state or (not library.flags:GetState(key))
	if desired == library.flags:GetState(key) then return end
	flag:SetState(desired)
end

-- Tween Helper
local function tween(obj, props, t, style, dir)
	return TweenService:Create(obj, TweenInfo.new(t or 0.25, Enum.EasingStyle[style or "Sine"], Enum.EasingDirection[dir or "Out"]), props)
end

-- Draggable
local function makeDraggable(dragHandle: GuiObject, target: GuiObject)
	local dragging, dragStart, startPos = false, nil, nil
	dragHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = target.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
end

-- 选中标签样式切换
local function switchTab(newBundle)
	local current = library.currentTab
	if current == newBundle then return end
	library.currentTab = newBundle

	-- 老的
	if current then
		local btn = current[2]
		if btn then
			local stroke = btn:FindFirstChild("BtnStroke")
			if stroke then stroke.Thickness = 1; stroke.Color = THEME.BORDER end
			btn.TextColor3 = THEME.TEXT
			local glow = btn:FindFirstChild("Glow")
			if glow then tween(glow, { Transparency = 1 }, 0.2):Play() end
		end
		if current[1] then current[1].Visible = false end
	end

	-- 新的
	if newBundle then
		local btn = newBundle[2]
		if btn then
			local stroke = btn:FindFirstChild("BtnStroke")
			if stroke then stroke.Thickness = 2; stroke.Color = THEME.ACCENT end
			btn.TextColor3 = THEME.ACCENT
			local glow = btn:FindFirstChild("Glow")
			if glow then tween(glow, { Transparency = 0 }, 0.2):Play() end
		end
		if newBundle[1] then newBundle[1].Visible = true end
	end
end

