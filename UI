            Space = true,
            Tab = true,
            Backquote = true,
            CapsLock = true,
            Escape = true,
            Unknown = true
        }
        
        local KEY_DISPLAY_NAMES = {
            RightControl = "右Ctrl",
            LeftControl = "左Ctrl",
            LeftShift = "左Shift",
            RightShift = "右Shift",
            Semicolon = ";",
            Quote = '"',
            LeftBracket = "[",
            RightBracket = "]",
