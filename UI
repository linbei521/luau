-- 切换标签指示器
local function switchTab(newBundle)
	local current = library.currentTab
	if current == newBundle then return end
	library.currentTab = newBundle

	if current then
		local btn = current[2]
		if btn then
			local stroke = btn:FindFirstChild("BtnStroke")
			if stroke then stroke.Thickness = 1; stroke.Color = THEME.BORDER end
			btn.TextColor3 = THEME.TEXT
			local glow = btn:FindFirstChild("Glow")
			if glow then tween(glow, { Transparency = 1 }, 0.2):Play() end
			tween(btn, { BackgroundColor3 = THEME.WHITE }, 0.15):Play()
		end
		if current[1] then current[1].Visible = false end
	end

	if newBundle then
		local btn = newBundle[2]
		if btn then
			local stroke = btn:FindFirstChild("BtnStroke")
			if stroke then stroke.Thickness = 2; stroke.Color = THEME.ACCENT end
			btn.TextColor3 = THEME.ACCENT
			local glow = btn:FindFirstChild("Glow")
			if glow then tween(glow, { Transparency = 0 }, 0.2):Play() end
			tween(btn, { BackgroundColor3 = PRIMARY_CONTAINER }, 0.15):Play()
		end
		if newBundle[1] then newBundle[1].Visible = true end
	end
end

