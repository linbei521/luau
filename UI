local Library = {}
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

-- 颜色主题配置
Library.Theme = {
    -- 主要颜色
    Background = Color3.fromRGB(20, 20, 30),
    Secondary = Color3.fromRGB(30, 30, 45),
    Accent = Color3.fromRGB(100, 150, 255),
    
    -- UI元素颜色
    Button = Color3.fromRGB(40, 40, 60),
    ButtonHover = Color3.fromRGB(50, 50, 75),
    ButtonActive = Color3.fromRGB(60, 60, 85),
    
    -- 状态颜色
    Success = Color3.fromRGB(0, 200, 100),
    Error = Color3.fromRGB(200, 50, 50),
    Warning = Color3.fromRGB(255, 180, 0),
    
    -- 文本颜色
    Text = Color3.fromRGB(255, 255, 255),
    TextDark = Color3.fromRGB(180, 180, 180),
    
    -- 边框颜色
    Border = Color3.fromRGB(60, 60, 80)
}

-- 动画配置
Library.AnimationSpeed = 0.3

-- 创建主窗口
function Library:CreateWindow(config)
    config = config or {}
    local WindowTitle = config.Title or "脚本UI"
    local WindowSize = config.Size or UDim2.new(0, 550, 0, 450)
    
    -- 创建ScreenGui
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "CustomUILib_" .. math.random(1000, 9999)
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.ResetOnSpawn = false
    
    -- 检测执行环境
    if syn then
        syn.protect_gui(ScreenGui)
        ScreenGui.Parent = game.CoreGui
    elseif gethui then
        ScreenGui.Parent = gethui()
    else
        ScreenGui.Parent = game.CoreGui
    end
    
    -- 主框架
    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Parent = ScreenGui
    MainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    MainFrame.BackgroundColor3 = self.Theme.Background
    MainFrame.BorderSizePixel = 0
    MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
    MainFrame.Size = WindowSize
    MainFrame.ClipsDescendants = true
    
    -- 主框架圆角
    local MainCorner = Instance.new("UICorner")
    MainCorner.CornerRadius = UDim.new(0, 10)
    MainCorner.Parent = MainFrame
    
    -- 主框架边框
    local MainStroke = Instance.new("UIStroke")
    MainStroke.Color = self.Theme.Border
    MainStroke.Thickness = 2
    MainStroke.Parent = MainFrame
    
    -- 阴影效果
    local Shadow = Instance.new("ImageLabel")
    Shadow.Name = "Shadow"
    Shadow.Parent = MainFrame
    Shadow.AnchorPoint = Vector2.new(0.5, 0.5)
    Shadow.BackgroundTransparency = 1
    Shadow.Position = UDim2.new(0.5, 0, 0.5, 0)
    Shadow.Size = UDim2.new(1, 30, 1, 30)
    Shadow.ZIndex = 0
    Shadow.Image = "rbxassetid://6015897843"
    Shadow.ImageColor3 = Color3.fromRGB(0, 0, 0)
    Shadow.ImageTransparency = 0.5
    Shadow.ScaleType = Enum.ScaleType.Slice
    Shadow.SliceCenter = Rect.new(49, 49, 450, 450)
    
    -- 标题栏
    local TitleBar = Instance.new("Frame")
    TitleBar.Name = "TitleBar"
    TitleBar.Parent = MainFrame
    TitleBar.BackgroundColor3 = self.Theme.Secondary
    TitleBar.BorderSizePixel = 0
    TitleBar.Size = UDim2.new(1, 0, 0, 45)
    
    local TitleCorner = Instance.new("UICorner")
    TitleCorner.CornerRadius = UDim.new(0, 10)
    TitleCorner.Parent = TitleBar
    
    -- 修复标题栏底部圆角
    local TitleFix = Instance.new("Frame")
    TitleFix.Parent = TitleBar
    TitleFix.BackgroundColor3 = self.Theme.Secondary
    TitleFix.BorderSizePixel = 0
    TitleFix.Position = UDim2.new(0, 0, 1, -10)
    TitleFix.Size = UDim2.new(1, 0, 0, 10)
    
    -- 标题文本
    local Title = Instance.new("TextLabel")
    Title.Name = "Title"
    Title.Parent = TitleBar
    Title.BackgroundTransparency = 1
    Title.Position = UDim2.new(0, 15, 0, 0)
    Title.Size = UDim2.new(1, -100, 1, 0)
    Title.Font = Enum.Font.GothamBold
    Title.Text = "📱 " .. WindowTitle
    Title.TextColor3 = self.Theme.Text
    Title.TextSize = 16
    Title.TextXAlignment = Enum.TextXAlignment.Left
    
    -- 最小化按钮
    local MinimizeButton = Instance.new("TextButton")
    MinimizeButton.Name = "MinimizeButton"
    MinimizeButton.Parent = TitleBar
    MinimizeButton.BackgroundColor3 = self.Theme.Warning
    MinimizeButton.BorderSizePixel = 0
    MinimizeButton.Position = UDim2.new(1, -70, 0.5, -12)
    MinimizeButton.Size = UDim2.new(0, 28, 0, 28)
    MinimizeButton.AutoButtonColor = false
    MinimizeButton.Font = Enum.Font.GothamBold
    MinimizeButton.Text = "—"
    MinimizeButton.TextColor3 = self.Theme.Text
    MinimizeButton.TextSize = 16
    
    local MinCorner = Instance.new("UICorner")
    MinCorner.CornerRadius = UDim.new(0, 6)
    MinCorner.Parent = MinimizeButton
    
    -- 关闭按钮
    local CloseButton = Instance.new("TextButton")
    CloseButton.Name = "CloseButton"
    CloseButton.Parent = TitleBar
    CloseButton.BackgroundColor3 = self.Theme.Error
    CloseButton.BorderSizePixel = 0
    CloseButton.Position = UDim2.new(1, -35, 0.5, -12)
    CloseButton.Size = UDim2.new(0, 28, 0, 28)
    CloseButton.AutoButtonColor = false
    CloseButton.Font = Enum.Font.GothamBold
    CloseButton.Text = "✕"
    CloseButton.TextColor3 = self.Theme.Text
    CloseButton.TextSize = 16
    
    local CloseCorner = Instance.new("UICorner")
    CloseCorner.CornerRadius = UDim.new(0, 6)
    CloseCorner.Parent = CloseButton
    
    -- 标签页容器
    local TabContainer = Instance.new("Frame")
    TabContainer.Name = "TabContainer"
    TabContainer.Parent = MainFrame
    TabContainer.BackgroundColor3 = self.Theme.Secondary
    TabContainer.BorderSizePixel = 0
    TabContainer.Position = UDim2.new(0, 0, 0, 45)
    TabContainer.Size = UDim2.new(0, 150, 1, -45)
    
    -- 标签页列表
    local TabList = Instance.new("ScrollingFrame")
    TabList.Name = "TabList"
    TabList.Parent = TabContainer
    TabList.BackgroundTransparency = 1
    TabList.BorderSizePixel = 0
    TabList.Position = UDim2.new(0, 10, 0, 10)
    TabList.Size = UDim2.new(1, -20, 1, -20)
    TabList.CanvasSize = UDim2.new(0, 0, 0, 0)
    TabList.ScrollBarThickness = 4
    TabList.ScrollBarImageColor3 = self.Theme.Accent
    
    local TabLayout = Instance.new("UIListLayout")
    TabLayout.Parent = TabList
    TabLayout.SortOrder = Enum.SortOrder.LayoutOrder
    TabLayout.Padding = UDim.new(0, 8)
    
    -- 内容容器
    local ContentContainer = Instance.new("Frame")
    ContentContainer.Name = "ContentContainer"
    ContentContainer.Parent = MainFrame
    ContentContainer.BackgroundTransparency = 1
    ContentContainer.Position = UDim2.new(0, 150, 0, 45)
    ContentContainer.Size = UDim2.new(1, -150, 1, -45)
    
    -- 拖动功能
    local dragging = false
    local dragInput, dragStart, startPos
    
    local function update(input)
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
    
    TitleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    
    TitleBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            dragInput = input
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            update(input)
        end
    end)
    
    -- 最小化功能
    local minimized = false
    local originalSize = MainFrame.Size
    
    MinimizeButton.MouseButton1Click:Connect(function()
        minimized = not minimized
        local targetSize = minimized and UDim2.new(0, 550, 0, 45) or originalSize
        
        TweenService:Create(MainFrame, TweenInfo.new(self.AnimationSpeed), {
            Size = targetSize
        }):Play()
        
        MinimizeButton.Text = minimized and "□" or "—"
    end)
    
    -- 关闭功能
    CloseButton.MouseButton1Click:Connect(function()
        TweenService:Create(MainFrame, TweenInfo.new(self.AnimationSpeed), {
            Size = UDim2.new(0, 0, 0, 0)
        }):Play()
        
        wait(self.AnimationSpeed)
        ScreenGui:Destroy()
    end)
    
    -- 按钮悬停效果
    for _, button in pairs({MinimizeButton, CloseButton}) do
        button.MouseEnter:Connect(function()
            TweenService:Create(button, TweenInfo.new(0.2), {
                BackgroundColor3 = Color3.fromRGB(
                    math.min(button.BackgroundColor3.R * 255 + 30, 255),
                    math.min(button.BackgroundColor3.G * 255 + 30, 255),
                    math.min(button.BackgroundColor3.B * 255 + 30, 255)
                )
            }):Play()
        end)
        
        button.MouseLeave:Connect(function()
            TweenService:Create(button, TweenInfo.new(0.2), {
                BackgroundColor3 = button.Name == "CloseButton" and self.Theme.Error or self.Theme.Warning
            }):Play()
        end)
    end
    
    -- 入场动画
    MainFrame.Size = UDim2.new(0, 0, 0, 0)
    TweenService:Create(MainFrame, TweenInfo.new(self.AnimationSpeed, Enum.EasingStyle.Back), {
        Size = WindowSize
    }):Play()
    
    -- 窗口对象
    local Window = {
        ScreenGui = ScreenGui,
        MainFrame = MainFrame,
        TabList = TabList,
        TabLayout = TabLayout,
        ContentContainer = ContentContainer,
        Tabs = {}
    }
    
    -- 自动调整标签列表大小
    TabLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        TabList.CanvasSize = UDim2.new(0, 0, 0, TabLayout.AbsoluteContentSize.Y + 10)
    end)
    
    return Window
end

-- 创建标签页
function Library:CreateTab(window, tabName, icon)
    icon = icon or "📄"
    
    -- 标签按钮
    local TabButton = Instance.new("TextButton")
    TabButton.Name = "TabButton_" .. tabName
    TabButton.Parent = window.TabList
    TabButton.BackgroundColor3 = self.Theme.Button
    TabButton.BorderSizePixel = 0
    TabButton.Size = UDim2.new(1, 0, 0, 35)
    TabButton.AutoButtonColor = false
    TabButton.Font = Enum.Font.Gotham
    TabButton.Text = icon .. " " .. tabName
    TabButton.TextColor3 = self.Theme.Text
    TabButton.TextSize = 14
    TabButton.TextXAlignment = Enum.TextXAlignment.Left
    TabButton.TextXOffset = 10
    
    local TabCorner = Instance.new("UICorner")
    TabCorner.CornerRadius = UDim.new(0, 6)
    TabCorner.Parent = TabButton
    
    -- 标签内容
    local TabContent = Instance.new("ScrollingFrame")
    TabContent.Name = "TabContent_" .. tabName
    TabContent.Parent = window.ContentContainer
    TabContent.BackgroundTransparency = 1
    TabContent.BorderSizePixel = 0
    TabContent.Position = UDim2.new(0, 10, 0, 10)
    TabContent.Size = UDim2.new(1, -20, 1, -20)
    TabContent.CanvasSize = UDim2.new(0, 0, 0, 0)
    TabContent.ScrollBarThickness = 4
    TabContent.ScrollBarImageColor3 = self.Theme.Accent
    TabContent.Visible = false
    
    local ContentLayout = Instance.new("UIListLayout")
    ContentLayout.Parent = TabContent
    ContentLayout.SortOrder = Enum.SortOrder.LayoutOrder
    ContentLayout.Padding = UDim.new(0, 10)
    
    -- 自动调整内容大小
    ContentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        TabContent.CanvasSize = UDim2.new(0, 0, 0, ContentLayout.AbsoluteContentSize.Y + 10)
    end)
    
    -- 标签切换
    TabButton.MouseButton1Click:Connect(function()
        for _, tab in pairs(window.Tabs) do
            tab.Button.BackgroundColor3 = self.Theme.Button
            tab.Content.Visible = false
        end
        
        TabButton.BackgroundColor3 = self.Theme.Accent
        TabContent.Visible = true
    end)
    
    -- 悬停效果
    TabButton.MouseEnter:Connect(function()
        if TabButton.BackgroundColor3 ~= self.Theme.Accent then
            TabButton.BackgroundColor3 = self.Theme.ButtonHover
        end
    end)
    
    TabButton.MouseLeave:Connect(function()
        if TabButton.BackgroundColor3 ~= self.Theme.Accent then
            TabButton.BackgroundColor3 = self.Theme.Button
        end
    end)
    
    -- 如果是第一个标签，自动激活
    if #window.Tabs == 0 then
        TabButton.BackgroundColor3 = self.Theme.Accent
        TabContent.Visible = true
    end
    
    local Tab = {
        Button = TabButton,
        Content = TabContent,
        Layout = ContentLayout
    }
    
    table.insert(window.Tabs, Tab)
    
    return Tab
end

-- 创建按钮
function Library:CreateButton(tab, buttonText, callback)
    local Button = Instance.new("TextButton")
    Button.Name = "Button"
    Button.Parent = tab.Content
    Button.BackgroundColor3 = self.Theme.Button
    Button.BorderSizePixel = 0
    Button.Size = UDim2.new(1, 0, 0, 40)
    Button.AutoButtonColor = false
    Button.Font = Enum.Font.Gotham
    Button.Text = buttonText
    Button.TextColor3 = self.Theme.Text
    Button.TextSize = 14
    
    local ButtonCorner = Instance.new("UICorner")
    ButtonCorner.CornerRadius = UDim.new(0, 8)
    ButtonCorner.Parent = Button
    
    -- 点击效果
    Button.MouseButton1Click:Connect(function()
        Button.BackgroundColor3 = self.Theme.ButtonActive
        
        spawn(function()
            if callback then
                callback()
            end
        end)
        
        wait(0.15)
        Button.BackgroundColor3 = self.Theme.ButtonHover
    end)
    
    -- 悬停效果
    Button.MouseEnter:Connect(function()
        Button.BackgroundColor3 = self.Theme.ButtonHover
    end)
    
    Button.MouseLeave:Connect(function()
        Button.BackgroundColor3 = self.Theme.Button
    end)
    
    return Button
end

-- 创建开关
function Library:CreateToggle(tab, toggleText, default, callback)
    local ToggleFrame = Instance.new("Frame")
    ToggleFrame.Name = "ToggleFrame"
    ToggleFrame.Parent = tab.Content
    ToggleFrame.BackgroundColor3 = self.Theme.Button
    ToggleFrame.BorderSizePixel = 0
    ToggleFrame.Size = UDim2.new(1, 0, 0, 40)
    
