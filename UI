    function TabMethods:NewSlider(sliderText, flagName, defaultValue, minValue, maxValue, precise, callback)
        defaultValue = defaultValue or minValue
        callback = callback or EmptyFunction
        
        local Slider = Instance_new("TextButton")
        local SliderCorner = Instance_new("UICorner")
        local SliderBar = Instance_new("Frame")
        local BarCorner = Instance_new("UICorner")
        local SliderFill = Instance_new("Frame")
        local FillCorner = Instance_new("UICorner")
        local SliderValue = Instance_new("TextBox")
        local ValueCorner = Instance_new("UICorner")
        local AddButton = Instance_new("TextButton")
        local MinusButton = Instance_new("TextButton")
        
        -- 初始化flag
        library.flags[flagName] = {
            State = defaultValue,
            SetValue = function(self, value)
                local percentage = (Mouse.X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X
                if value then
                    percentage = (value - minValue) / (maxValue - minValue)
                end
                percentage = math.clamp(percentage, 0, 1)
                
                if precise then
                    value = value or tonumber(string.format("%.1f", tostring(minValue + (maxValue - minValue) * percentage)))
                else
                    value = value or math.floor(minValue + (maxValue - minValue) * percentage)
                end
                
                library.flags[flagName].State = tonumber(value)
                SliderValue.Text = tostring(value)
                SliderFill.Size = UDim2(percentage, 0, 1, 0)
                callback(tonumber(value))
            end
        }
        
        -- 配置滑块
