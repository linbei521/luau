        local IncrementButton = Instance.new("TextButton")
        IncrementButton.Name = "IncrementButton"
        IncrementButton.Parent = Slider
        IncrementButton.BackgroundTransparency = 1
        IncrementButton.Position = UDim2.new(0.808, 0, 0.179, 0)
        IncrementButton.Size = UDim2.new(0, 18, 0, 18)
        IncrementButton.Font = Enum.Font.Gotham
        IncrementButton.Text = "+"
        IncrementButton.TextColor3 = THEME.TEXT.PRIMARY
        IncrementButton.TextSize = 18
        
        -- 增加/减少
        DecrementButton.MouseButton1Click:Connect(function()
            local newValue = math.clamp(Library.flags[flagName].State - 1, minValue, maxValue)
            Library.flags[flagName]:SetValue(newValue)
        end)
        
        IncrementButton.MouseButton1Click:Connect(function()
            local newValue = math.clamp(Library.flags[flagName].State + 1, minValue, maxValue)
            Library.flags[flagName]:SetValue(newValue)
        end)
        
        -- 拖动
        local isDragging = false
        
        SliderBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or 
               input.UserInputType == Enum.UserInputType.Touch then
                Library.flags[flagName]:SetValue()
                isDragging = true
            end
        end)
        
        Services.UserInputService.InputEnded:Connect(function(input)
            if isDragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or 
               input.UserInputType == Enum.UserInputType.Touch) then
                isDragging = false
            end
        end)
        
        Services.UserInputService.InputChanged:Connect(function()
            if isDragging then
                Library.flags[flagName]:SetValue()
            end
        end)
        
        -- 文本输入
        local isFocused = false
        
        ValueDisplay.Focused:Connect(function()
            isFocused = true
        end)
        
        ValueDisplay.FocusLost:Connect(function()
            isFocused = false
            if ValueDisplay.Text == "" then
                Library.flags[flagName]:SetValue(defaultValue)
            end
        end)
        
        ValueDisplay:GetPropertyChangedSignal("Text"):Connect(function()
            if not isFocused then return end
            
            -- 移除非数字字符
            ValueDisplay.Text = ValueDisplay.Text:gsub("[^%d%-]", "")
            
            local value = ValueDisplay.Text
            
            if value ~= "" and value ~= "-" then
                local numValue = tonumber(value)
                if numValue then
                    if numValue > maxValue then
                        numValue = maxValue
                        ValueDisplay.Text = tostring(maxValue)
                    end
                    Library.flags[flagName]:SetValue(numValue)
                end
            end
        end)
        
        -- 设置初始值
        Library.flags[flagName]:SetValue(defaultValue)
        
        return Library.flags[flagName]
    end
    
