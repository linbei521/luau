	return plr:WaitForChild("PlayerGui")
end

--====================== Color Helpers (Material) ==================
local function clamp01(x) return (x < 0 and 0) or (x > 1 and 1) or x end

local function toColor3Any(c)
	if typeof(c) == "Color3" then return c end
	if type(c) == "table" then
		local r = c[1] or c.r or c.R
		local g = c[2] or c.g or c.G
		local b = c[3] or c.b or c.B
		if r and g and b then return dp(tonumber(r) or 0, tonumber(g) or 0, tonumber(b) or 0) end
	end
	if type(c) == "string" then
		local hex = c:gsub("#","")
		if #hex == 6 then
			local r = tonumber(hex:sub(1,2),16) or 0
			local g = tonumber(hex:sub(3,4),16) or 0
			local b = tonumber(hex:sub(5,6),16) or 0
			return dp(r,g,b)
		end
	end
	if type(c) == "number" then
		local r = bit32.rshift(c, 16) % 256
		local g = bit32.rshift(c, 8) % 256
		local b = c % 256
		return dp(r,g,b)
	end
	return nil
end

local function adjustSV(color, ds, dv)
	local h, s, v = color:ToHSV()
	s = clamp01(s + (ds or 0))
	v = clamp01(v + (dv or 0))
	return Color3.fromHSV(h, s, v)
end

