        KeyDisplay.Size = UDim2.new(0, 74, 0, 18)
        KeyDisplay.AutoButtonColor = false
        KeyDisplay.Font = Enum.Font.Gotham
        KeyDisplay.Text = displayText
        KeyDisplay.TextColor3 = THEME.TEXT.PRIMARY
        KeyDisplay.TextSize = 12
        
        local KeyDisplayCorner = Instance.new("UICorner")
        KeyDisplayCorner.CornerRadius = RADIUS.SMALL
        KeyDisplayCorner.Parent = KeyDisplay
        
        -- 监听按键
        Services.UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            if input.KeyCode ~= currentKey then return end
            
            pcall(callback, currentKey.Name)
        end)
        
        -- 重新绑定
        KeyDisplay.MouseButton1Click:Connect(function()
            KeyDisplay.Text = "..."
            task.wait()
            
            local input = Services.UserInputService.InputEnded:Wait()
            
            if input.UserInputType ~= Enum.UserInputType.Keyboard then
                KeyDisplay.Text = displayText
                return
            end
            
            local keyName = input.KeyCode.Name
            if KEY_BLACKLIST[keyName] then
                KeyDisplay.Text = displayText
                return
            end
            
            currentKey = Enum.KeyCode[keyName]
            displayText = KEY_DISPLAY_NAMES[keyName] or keyName
            KeyDisplay.Text = displayText
        end)
        
        return Keybind
    end
    
    function Tab:NewSlider(sliderText, flagName, defaultValue, minValue, maxValue, useDecimals, callback)
        callback = callback or function() end
        defaultValue = defaultValue or minValue
        useDecimals = useDecimals or false
        
        Library.flags[flagName] = {
            State = defaultValue,
            SetValue = function(self, newValue)
                local mousePos = (Mouse.X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X
                
                if newValue then
                    mousePos = (newValue - minValue) / (maxValue - minValue)
                end
                
                mousePos = math.clamp(mousePos, 0, 1)
                
                if useDecimals then
                    newValue = newValue or tonumber(string.format("%.1f", minValue + (maxValue - minValue) * mousePos))
                else
                    newValue = newValue or math.floor(minValue + (maxValue - minValue) * mousePos)
                end
                
                self.State = tonumber(newValue)
                ValueDisplay.Text = tostring(newValue)
                SliderFill.Size = UDim2.new(mousePos, 0, 1, 0)
                
                pcall(callback, tonumber(newValue))
            end
        }
        
        local Slider = Instance.new("TextButton")
