        local currentKey = defaultKey
        local displayText = defaultKey and (KEY_DISPLAY_NAMES[defaultKey.Name] or defaultKey.Name) or "无"
        
        local Keybind = Instance.new("TextButton")
        Keybind.Name = "Keybind_" .. bindText
