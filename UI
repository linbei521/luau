--========================== Self-Heal (3x) =========================
local function selfHeal()
	-- 1) Screen 挂载
	if not Screen.Parent then
		Screen.Parent = resolveGuiParent()
	end
	-- 2) 通知容器
	if not notificationHolder or not notificationHolder.Parent then
		notificationHolder = createBaseNotifications()
	end
	-- 3) Tab 可见性校验
	if not library.currentTab then
		local firstBtn = TabButtons:FindFirstChildWhichIsA("TextButton")
		local firstTab
		for _, child in ipairs(TabHolder:GetChildren()) do
			if child:IsA("ScrollingFrame") then firstTab = child break end
		end
		if firstBtn and firstTab then
			library.currentTab = { firstTab, firstBtn }
			firstTab.Visible = true
		end
	end
end

for i = 1, 3 do
	task.delay(i * 0.35, selfHeal)
end