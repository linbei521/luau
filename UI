function NotificationSystem:Notify(config)
    config = config or {}
    local tweenSpeed = config.TweenSpeed or 0.5
    local tweenInSpeed = config.TweenInSpeed or tweenSpeed
    local tweenOutSpeed = config.TweenOutSpeed or tweenSpeed
    local tweenVerticalSpeed = config.TweenVerticalSpeed or tweenSpeed
    local title = config.Title or "通知"
    local text = config.Text or ""
    local duration = config.Duration or 5
    
    self.activeNotifications = self.activeNotifications + 1
    local notifIndex = self.activeNotifications
    local trackPosition = notifIndex
    local isRemoved = false
    local shouldExist = true
    
    local holder = self:CreateNotificationHolder()
    local notif = holder.DefaultNotif:Clone()
    notif.Parent = holder
    notif.Visible = true
    notif.Position = UDim2.new(1, 300, 1, -5)
    notif.Title.Text = title
    notif.Paragraph.Text = text
    
    -- 滑入动画
    notif:TweenPosition(
        UDim2.new(1, -5, 1, -5),
        Enum.EasingDirection.Out,
        Enum.EasingStyle.Quint,
        tweenInSpeed
    )
    
    -- 点击关闭
    notif.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            Utils:CreateTween(notif, {Transparency = 0.8}, 0.3):Play()
            shouldExist = false
            isRemoved = true
            self.activeNotifications = self.activeNotifications - 1
            self.lastRemovedPosition = notif.Position.Y.Offset
        end
    end)
    
    -- 自动关闭
    task.delay(duration + tweenInSpeed, function()
        shouldExist = false
    end)
    
    -- 位置管理
    task.spawn(function()
        local originalPos = notif.Position
        while shouldExist and task.wait() do
            local currentPos = notif.Position
            local offset = 65 * (self.activeNotifications - notifIndex)
            
            if self.activeNotifications > trackPosition then
                notif:TweenPosition(
                    UDim2.new(1, -5, 1, originalPos.Y.Offset - offset),
                    Enum.EasingDirection.Out,
                    Enum.EasingStyle.Quint,
                    tweenVerticalSpeed,
                    true
                )
                trackPosition = trackPosition + 1
            elseif self.activeNotifications < trackPosition then
                if self.lastRemovedPosition and self.lastRemovedPosition > currentPos.Y.Offset then
                    notif:TweenPosition(
                        UDim2.new(1, -5, 1, originalPos.Y.Offset - offset),
                        Enum.EasingDirection.Out,
                        Enum.EasingStyle.Quint,
                        tweenVerticalSpeed,
                        true
                    )
                else
                    notifIndex = notifIndex - 1
                end
                trackPosition = trackPosition - 1
            end
        end
        
        -- 滑出并清理
        local finalPos = notif.Position
        if not isRemoved then
            self.activeNotifications = self.activeNotifications - 1
            self.lastRemovedPosition = finalPos.Y.Offset
        end
        
        notif:TweenPosition(
            UDim2.new(1, 300, 1, finalPos.Y.Offset),
            Enum.EasingDirection.Out,
            Enum.EasingStyle.Quint,
            tweenOutSpeed,
            true
        )
        
        task.wait(tweenOutSpeed)
        notif:Destroy()
    end)
end

function NotificationSystem:SelectNotify(config)
    config = config or {}
    local tweenSpeed = config.TweenSpeed or 0.5
    local tweenInSpeed = config.TweenInSpeed or tweenSpeed
    local tweenOutSpeed = config.TweenOutSpeed or tweenSpeed
    local tweenVerticalSpeed = config.TweenVerticalSpeed or tweenSpeed
    local title = config.Title or "确认"
    local text = config.Text or ""
    local yesText = config.TrueText or "是"
    local noText = config.FalseText or "否"
    local duration = config.Duration or 10
    local callback = config.Callback or function() end
    
    self.activeNotifications = self.activeNotifications + 1
    local notifIndex = self.activeNotifications
    local trackPosition = notifIndex
    local isRemoved = false
    local shouldExist = true
    
    local holder = self:CreateNotificationHolder()
    local notif = holder.ToggleNotif:Clone()
    notif.Parent = holder
    notif.Visible = true
    notif.Position = UDim2.new(1, 300, 1, -5)
    notif.Title.Text = title
    notif.Paragraph.Text = text
    notif.YesButton.Text = yesText
    notif.NoButton.Text = noText
    
    local function dismiss(result)
        shouldExist = false
        isRemoved = true
        self.activeNotifications = self.activeNotifications - 1
        self.lastRemovedPosition = notif.Position.Y.Offset
        pcall(callback, result)
    end
    
    notif.YesButton.MouseButton1Click:Connect(function()
        dismiss(true)
    end)
    
    notif.NoButton.MouseButton1Click:Connect(function()
        dismiss(false)
    end)
    
    -- 滑入动画
    notif:TweenPosition(
        UDim2.new(1, -5, 1, -5),
        Enum.EasingDirection.Out,
        Enum.EasingStyle.Quint,
        tweenInSpeed
    )
    
    -- 自动关闭
